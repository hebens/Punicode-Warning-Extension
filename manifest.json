{
  "manifest_version": 3,
  "name": "Punycode URL Warning",
  "description": "Warnt automatisch bei Punycode-Domains (xn--).",
  "version": "1.1",
  "action": {
    "default_title": "Punycode Detector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
],
  "icons": {
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "punycode-warning@example.com"
    }
  }
}
